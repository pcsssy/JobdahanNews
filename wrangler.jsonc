{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jobdahan-news",
  "main": "./cloudflare/worker.mjs",
  "compatibility_date": "2026-10-09",
  "build": {
    "command": "node cloudflare/build-assets.mjs"
  },
  "assets": {
    "directory": "./cloudflare/public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
